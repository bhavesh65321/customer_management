# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — copy this to .env and fill in real values.
# NEVER commit .env to git. Only .env.example is committed.
# ─────────────────────────────────────────────────────────────────────────────

# Database
# For passwords with special chars: @ → %40,  # → %23,  $ → %24
DATABASE_URL=mysql+pymysql://root:root%40123@localhost:3306/customer_management_app

# JWT — generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_real_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Environment: development | staging | production
# production → disables /api/docs, /api/redoc, /api/openapi.json
ENV=development

# CORS — comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis (rate limiting — required in production)
REDIS_URL=redis://localhost:6379/0

# Database (set as needed)
# DATABASE_URL=mysql+pymysql://user:pass@localhost/dbname

# Purchase order email (SMTP)
# Leave unset to skip email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=your-email@gmail.com

# Purchase order SMS (Twilio)
# Leave unset to skip SMS notifications
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+1234567890

# WhatsApp (Twilio WhatsApp Business API — same SID/token as SMS)
# From must be whatsapp:+<sandbox or approved business number>
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional toggles (default on): NOTIFY_WHATSAPP_ON_PURCHASE=1, NOTIFY_WHATSAPP_ON_REMINDER=1

# Firebase Cloud Messaging (mobile / PWA push). Path to service account JSON from Firebase console.
# Leave unset to skip push. Set FCM_PUSH_DISABLED=1 to force off.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# Optional: NOTIFY_PUSH_ON_PURCHASE=1, NOTIFY_PUSH_ON_REMINDER=1

# AI business review & AI Assistant chat. Without OPENAI_API_KEY the app uses built-in rule-based answers.
# Get your key from: https://platform.openai.com/api-keys
# gpt-4o-mini is fast + very affordable (~$0.15 per 1M input tokens)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Order / repair customer notifications (SMS needs TWILIO_*; email needs SMTP_*; WhatsApp needs TWILIO_WHATSAPP_FROM)
# NOTIFY_ORDER_EMAIL=1
# NOTIFY_ORDER_SMS=1
# NOTIFY_ORDER_WHATSAPP=1
# NOTIFY_ORDER_PUSH=1
# NOTIFY_ORDER_DUE_REMINDER_EMAIL=1
# NOTIFY_ORDER_DUE_REMINDER_SMS=1
# NOTIFY_ORDER_DUE_REMINDER_WHATSAPP=1
# NOTIFY_ORDER_DUE_REMINDER_PUSH=1
