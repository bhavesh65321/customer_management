# ============================================
# DATABASE CONFIGURATION
# ============================================
MYSQL_ROOT_PASSWORD=root@123
MYSQL_DATABASE=customer_management_app
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_PORT=3306

# ============================================
# BACKEND CONFIGURATION
# ============================================
SECRET_KEY=your-super-secret-key-change-this-in-production-use-a-random-string
REFRESH_SECRET_KEY=your-super-secret-refresh-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENV=development
DEBUG=True
BACKEND_PORT=8000

# ============================================
# FRONTEND CONFIGURATION
# ============================================
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_TIMEOUT=30000
FRONTEND_PORT=3000

# ============================================
# PHPMYADMIN CONFIGURATION (Optional)
# ============================================
PHPMYADMIN_PORT=8080

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@customermanagement.com

# ============================================
# AWS/CLOUD CONFIGURATION (Optional)
# ============================================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
